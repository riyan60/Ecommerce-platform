generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  VENDOR
  CUSTOMER
}

model User {
  id           String   @id @default(uuid())

  name         String

  email        String   @unique

  password     String

  role         Role     @default(CUSTOMER)

  isVerified   Boolean  @default(false)

  createdAt    DateTime @default(now())

  updatedAt    DateTime @updatedAt
}
